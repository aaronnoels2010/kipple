{
  "name": "kipple",
  "private": true,
  "description": "Kipple: a free, open-source file organiser for Linux, macOS and Windows",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaronnoels2010/kipple.git"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:spdx": "bash scripts/check-spdx.sh",
    "check:npm-licenses": "node scripts/check-npm-licenses.mjs",
    "test:scripts": "bash scripts/tests/check-spdx.test.sh && bash scripts/tests/create-release-secrets.test.sh && node --test \"scripts/tests/*.test.mjs\""
  }
}
