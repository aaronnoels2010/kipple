{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "The main window. Only the permissions the UI actually uses: add specific allow-* entries per feature. Never core:default, fs, shell, opener or dialog: every file operation goes through Kipple's own validated commands (ADR-0007).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-get-locale",
    "allow-get-appearance",
    "allow-set-theme-preference",
    "allow-locations-list",
    "allow-locations-add-default",
    "allow-locations-add-via-dialog",
    "allow-locations-remove",
    "allow-locations-set-enabled",
    "allow-scan-start",
    "allow-scan-pause",
    "allow-scan-resume",
    "allow-scan-cancel",
    "allow-scan-status",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
